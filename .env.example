# ─── CineCue environment ──────────────────────────────────────────────
# Copy this file to `.env` and fill in real values. Never commit `.env`.
#
# MONGODB_URI is SERVER-SIDE ONLY (API/sync layer, EAS secrets, CI).
# Do NOT prefix it with EXPO_PUBLIC_ — anything EXPO_PUBLIC_* is inlined
# into the client bundle at build time and would leak the database URI.
# The Expo client never connects to MongoDB directly; see src/config/env.ts.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<database>?retryWrites=true&w=majority

# ─── Client-safe (bundled into the app) ───────────────────────────────────
# Public base URL of the deployed cinecue-server (see backend/). A plain
# https URL is safe to inline with the EXPO_PUBLIC_ prefix.
EXPO_PUBLIC_API_URL=https://your-deployment-link
